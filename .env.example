# Local development environment for compose.yaml. Copy to `.env` (git-ignored) and replace every `change-me`.
# These values are for local containers only. Real environments receive secrets from HashiCorp Vault.

COMPOSE_PROJECT_NAME=diligence
# Host ports, change if they clash with other local services
BACKEND_PORT=8080
BACKEND_MANAGEMENT_PORT=8081
FRONTEND_PORT=3000
OBJECT_STORAGE_PORT=9000
GRAFANA_PORT=3001
APP_ENVIRONMENT=local

# PostgreSQL
POSTGRES_DB=diligence
POSTGRES_USER=diligence
POSTGRES_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USERNAME=diligence
RABBITMQ_PASSWORD=change-me

# S3-compatible object storage (SeaweedFS locally)
S3_ACCESS_KEY_ID=diligence
S3_SECRET_ACCESS_KEY=change-me-at-least-8-chars
S3_BUCKET=diligence-documents
S3_REGION=us-east-1

# OpenSearch (security plugin disabled locally; enabled in every real environment)
OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"

# Keycloak master-realm bootstrap admin (local only)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Secret of the diligence-admin-api service account (backend → Keycloak Admin API); set by `make keycloak-bootstrap`
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-generate-with-openssl-rand-hex-32
# Local users created by `make keycloak-bootstrap` (the admin must enrol OTP on first login)
KEYCLOAK_DEV_ADMIN=admin.local
KEYCLOAK_DEV_ADMIN_PASSWORD=change-me-min-12-chars
KEYCLOAK_DEV_PM=pm.local
KEYCLOAK_DEV_PM_PASSWORD=change-me-min-12-chars
# Optional TOTP secret for the local PM (every role requires OTP, #161), used by the e2e tests and the DAST sign-in.
# Leave the placeholder to set up an authenticator interactively on the first sign-in.
KEYCLOAK_DEV_TOTP_SECRET=change-me-totp-secret
# Optional end-to-end users e2e.partner / e2e.analyst / e2e.target / e2e.client (tests/e2e), created only when both
# are set to real values. All of them get OTP from the secret; generate one with
#   python3 -c 'import base64,os;print(base64.b32encode(os.urandom(20)).decode())'
KEYCLOAK_E2E_PASSWORD=change-me-min-12-chars
KEYCLOAK_E2E_TOTP_SECRET=change-me-base32-secret
# Optional internal SSO (PRD ADM-02). Leave empty to skip. When a client id is set, ENTRA_TENANT_ID (the firm's
# tenant id) or GOOGLE_HOSTED_DOMAIN (the firm's Workspace domain) is required.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=

# Frontend session encryption key (at least 32 characters): openssl rand -base64 48
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-48

# Rate limiting controls (apps/frontend/src/proxy.ts). Set to true in test/CI to bypass (ignored in production).
RATE_LIMIT_DISABLED=false
RATE_LIMIT_ACTION_MAX=60
RATE_LIMIT_AUTH_MAX=30

# Webhook signing keys are encrypted at rest with this AES-256 key (#64): openssl rand -base64 32. Left unset locally,
# the local profile uses an all-zero development key (an empty value would disable it, so keep the line commented).
# WEBHOOK_KEY_ENCRYPTION_KEY=

# Per-user API rate limit in the backend (#63): requests per user and minute; search, downloads and exports have the
# stricter limit. Load tests that reuse one account set USER_RATE_LIMIT_ENABLED=false.
USER_RATE_LIMIT_ENABLED=true
USER_RATE_LIMIT_PER_MINUTE=600
USER_RATE_LIMIT_EXPENSIVE_PER_MINUTE=60

# HashiCorp Vault (dev mode, in-memory, local only)
VAULT_DEV_ROOT_TOKEN=change-me

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Error tracking (optional)
SENTRY_DSN=

# Tesseract OCR languages for scanned documents and images (default: eng+ind)
OCR_LANGUAGES=eng+ind
