# Local development environment for compose.yaml. Copy to `.env` (git-ignored) and replace every `change-me`.
# These values are for local containers only. Real environments receive secrets from HashiCorp Vault.

COMPOSE_PROJECT_NAME=platform
APP_ENVIRONMENT=local

# PostgreSQL
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USERNAME=platform
RABBITMQ_PASSWORD=change-me

# S3-compatible object storage (MinIO locally)
S3_ACCESS_KEY_ID=platform
S3_SECRET_ACCESS_KEY=change-me-at-least-8-chars
S3_BUCKET=platform-documents
S3_REGION=us-east-1

# OpenSearch (security plugin disabled locally; enabled in every real environment)
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# Keycloak bootstrap admin (local only)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Used by infrastructure/docker/scripts/keycloak-create-dev-user.sh
KEYCLOAK_DEV_USER=developer
KEYCLOAK_DEV_USER_PASSWORD=change-me

# HashiCorp Vault (dev mode, in-memory, local only)
VAULT_DEV_ROOT_TOKEN=change-me

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Error tracking (optional)
SENTRY_DSN=
