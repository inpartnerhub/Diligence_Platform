# Copy to .env.local for `npm run dev`. Values prefixed NEXT_PUBLIC_ are embedded in the browser bundle:
# never put secrets in them. Everything else stays on the server (BFF: tokens never reach the browser).

# Public origin of this app (OIDC redirect URI = APP_BASE_URL/auth/callback)
APP_BASE_URL=http://localhost:3000
# Server-side base URL of the API (through Kong locally: http://localhost:8000)
API_BASE_URL=http://localhost:8000

# OIDC (Keycloak) — public client "diligence-web", Authorization Code + PKCE
OIDC_ISSUER=http://localhost:8180/realms/diligence
# Back-channel issuer address when it differs from the public one (containers); empty = OIDC_ISSUER
OIDC_INTERNAL_ISSUER=
OIDC_CLIENT_ID=diligence-web
# Local stack only: Keycloak runs on plain HTTP. Must be unset/false anywhere else.
OIDC_ALLOW_HTTP=true

# Server-side session store and cookie sealing key (>= 32 chars): openssl rand -base64 48
REDIS_URL=redis://:change-me@localhost:6379/1
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-48

# Observability
NEXT_PUBLIC_APP_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
