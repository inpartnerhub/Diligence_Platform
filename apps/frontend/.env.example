# Copy to .env.local for `npm run dev`. Values prefixed NEXT_PUBLIC_ are embedded in the browser bundle:
# never put secrets in them.

# Server-side base URL of the API (through Kong locally: http://localhost:8000)
API_BASE_URL=http://localhost:8000

# OIDC (Keycloak) — public client using Authorization Code + PKCE
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8180/realms/platform
NEXT_PUBLIC_OIDC_CLIENT_ID=platform-frontend

# Observability
NEXT_PUBLIC_APP_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
