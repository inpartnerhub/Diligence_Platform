# Single-server production configuration for compose.prod.yaml.
# Copy to .env.prod (git-ignored) and replace every "change-me" placeholder before launching.
# Generate strong random values with:
#   openssl rand -hex 32
#   openssl rand -base64 32
#   openssl rand -base64 48

COMPOSE_PROJECT_NAME=diligence-prod
APP_ENVIRONMENT=prod
LOG_FORMAT=ecs

# Immutable GHCR tags — pin to the sha-<commit> tag built by GitHub Actions on main (e.g. sha-1b33b2e) for
# reproducible, rollback-able releases. The placeholder below fails to pull on purpose: never run :main in prod.
IMAGE_TAG=sha-REPLACE_WITH_RELEASED_COMMIT
KEYCLOAK_IMAGE_TAG=sha-REPLACE_WITH_RELEASED_COMMIT
PROCESSING_IMAGE_TAG=sha-REPLACE_WITH_RELEASED_COMMIT

# Public domains & TLS certificate contact (DNS A/AAAA records must point to this server)
APP_DOMAIN=app.example.com
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=ops@example.com

# PostgreSQL (single instance hosts both diligence and keycloak databases)
POSTGRES_DB=diligence
POSTGRES_USER=diligence
POSTGRES_PASSWORD=change-me-postgres-password
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db-password

# Redis (sessions, rate-limit counters, shared cache)
REDIS_PASSWORD=change-me-redis-password

# Keycloak bootstrap & OIDC client secrets
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-generate-with-openssl-rand-hex-32
OIDC_CLIENT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Frontend session keys
# SESSION_SECRET >= 32 chars (openssl rand -base64 48)
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-48
# SESSION_ENCRYPTION_KEY = base64 of 32 bytes (openssl rand -base64 32)
SESSION_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# Backend AES-256-GCM key for encrypting webhook signing keys (openssl rand -base64 32)
WEBHOOK_KEY_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# Object storage: AWS S3, Cloudflare R2, or local SeaweedFS (--profile local-storage).
# For AWS S3: leave S3_ENDPOINT empty and S3_PATH_STYLE=false (or attach IAM instance profile).
# For Cloudflare R2: set S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto, S3_PATH_STYLE=true.
# For --profile local-storage: set S3_ENDPOINT=http://object-storage:9000, S3_PATH_STYLE=true.
S3_ENDPOINT=
S3_REGION=ap-southeast-3
S3_BUCKET=diligence-documents
S3_PATH_STYLE=false
AWS_ACCESS_KEY_ID=change-me-s3-access-key
AWS_SECRET_ACCESS_KEY=change-me-s3-secret-key

# Transactional e-mail (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me-smtp-user
SMTP_PASSWORD=change-me-smtp-password
SMTP_STARTTLS=true
MAIL_FROM=Diligence Platform <no-reply@example.com>

# Optional: heavy document processors (--profile processing).
# Leave TIKA_URL/GOTENBERG_URL empty in ultra-lean mode (uses embedded PDFBox/POI for detection,
# text extraction, PDF exports, modern Office previews, and PDF/image previews).
#
# MALWARE SCANNING IS MANDATORY and is NOT embedded. CLAMAV_MODE=required (the secure default) fails closed:
# uploads are refused until you choose one of the two production-safe options below, so the data room never
# silently accepts unscanned files. Pick one:
#   1. In-process ClamAV — enable --profile processing (needs the 8 GiB preset) and set:
#        CLAMAV_MODE=clamav
#        CLAMAV_HOST=clamav
#        TIKA_URL=http://tika:9998
#        GOTENBERG_URL=http://gotenberg:3000
#   2. External scanning — set CLAMAV_MODE=external ONLY if your object store actually scans for malware
#      (e.g. AWS S3 GuardDuty Malware Protection). Do NOT use this with --profile local-storage or a plain
#      bucket with no scanning.
TIKA_URL=
GOTENBERG_URL=
CLAMAV_MODE=required
CLAMAV_HOST=
OCR_LANGUAGES=eng+ind
# Bound concurrent uploads, DB pool, and preview cache inside the default 1 GiB backend container.
DB_POOL_SIZE=10
HTTP_MAX_CONCURRENT_UPLOADS=2
PREVIEW_CACHE_MAX_SIZE=32MB
# Advanced safety guardrails (sensible defaults; raise only if legitimate long jobs are being killed).
# DB_STATEMENT_TIMEOUT caps any single SQL statement; DB_IDLE_IN_TX_TIMEOUT aborts transactions left idle; both
# protect the small connection pool from a runaway query. PIDS_LIMIT caps processes/threads per container.
# DB_STATEMENT_TIMEOUT=30s
# DB_IDLE_IN_TX_TIMEOUT=60s
# PIDS_LIMIT=2048

# ---------------------------------------------------------------- Server Sizing Preset
# Active defaults in compose.prod.yaml target a 2 vCPU / 4 GiB RAM (+ 2 GiB swap) starter VPS (~1.6-2.2 GiB RAM).
# When scaling up to a 4 vCPU / 8 GiB RAM VPS (>30 concurrent users / heavier reports), uncomment the preset below:
# CADDY_MEM_LIMIT=128m
# POSTGRES_MEM_LIMIT=1536m
# POSTGRES_SHARED_BUFFERS=384MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
# POSTGRES_WORK_MEM=8MB
# POSTGRES_MAX_CONNECTIONS=100
# REDIS_MEM_LIMIT=256m
# REDIS_MAXMEMORY=192mb
# KEYCLOAK_MEM_LIMIT=768m
# KEYCLOAK_JAVA_OPTS=-Xms128m -Xmx512m
# BACKEND_MEM_LIMIT=1536m
# BACKEND_JAVA_OPTS=-Xms256m -Xmx1024m -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/urandom
# DB_POOL_SIZE=20
# HTTP_MAX_CONCURRENT_UPLOADS=4
# PREVIEW_CACHE_MAX_SIZE=64MB
# FRONTEND_MEM_LIMIT=512m
# FRONTEND_NODE_OPTS=--max-old-space-size=384

# Observability / backups
USER_RATE_LIMIT_ENABLED=true
# Strongly recommended in single-server deployments for production OOM/error alerting.
SENTRY_DSN=
BACKUP_RETENTION_DAYS=14
BACKUP_S3_URI=
