# Single-server production configuration for compose.prod.yaml.
# Copy to .env.prod (git-ignored) and replace every "change-me" placeholder before launching.
# Generate strong random values with:
#   openssl rand -hex 32
#   openssl rand -base64 32
#   openssl rand -base64 48

COMPOSE_PROJECT_NAME=diligence-prod
APP_ENVIRONMENT=prod
LOG_FORMAT=ecs

# Immutable GHCR tags (pin to sha-<commit> from GitHub Actions on main for reproducible releases)
IMAGE_TAG=main
KEYCLOAK_IMAGE_TAG=main
PROCESSING_IMAGE_TAG=main

# Public domains & TLS certificate contact (DNS A/AAAA records must point to this server)
APP_DOMAIN=app.example.com
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=ops@example.com

# PostgreSQL (single instance hosts both diligence and keycloak databases)
POSTGRES_DB=diligence
POSTGRES_USER=diligence
POSTGRES_PASSWORD=change-me-postgres-password
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db-password

# Redis (sessions, rate-limit counters, shared cache)
REDIS_PASSWORD=change-me-redis-password

# Keycloak bootstrap & OIDC client secrets
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-generate-with-openssl-rand-hex-32
OIDC_CLIENT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Frontend session keys
# SESSION_SECRET >= 32 chars (openssl rand -base64 48)
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-48
# SESSION_ENCRYPTION_KEY = base64 of 32 bytes (openssl rand -base64 32)
SESSION_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# Backend AES-256-GCM key for encrypting webhook signing keys (openssl rand -base64 32)
WEBHOOK_KEY_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# Object storage: AWS S3, Cloudflare R2, or local SeaweedFS (--profile local-storage).
# For AWS S3: leave S3_ENDPOINT empty and S3_PATH_STYLE=false (or attach IAM instance profile).
# For Cloudflare R2: set S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto, S3_PATH_STYLE=true.
# For --profile local-storage: set S3_ENDPOINT=http://object-storage:9000, S3_PATH_STYLE=true.
S3_ENDPOINT=
S3_REGION=ap-southeast-3
S3_BUCKET=diligence-documents
S3_PATH_STYLE=false
AWS_ACCESS_KEY_ID=change-me-s3-access-key
AWS_SECRET_ACCESS_KEY=change-me-s3-secret-key

# Transactional e-mail (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me-smtp-user
SMTP_PASSWORD=change-me-smtp-password
SMTP_STARTTLS=true
MAIL_FROM=Diligence Platform <no-reply@example.com>

# Optional: heavy document processors (--profile processing).
# Leave empty in ultra-lean mode (uses embedded PDFBox/POI for detection & text extraction, and PDF/image previews).
# Set these only when running --profile processing (or external processor endpoints):
# TIKA_URL=http://tika:9998
# GOTENBERG_URL=http://gotenberg:3000
# CLAMAV_HOST=clamav
TIKA_URL=
GOTENBERG_URL=
CLAMAV_HOST=
OCR_LANGUAGES=eng+ind

# Optional observability / backups
USER_RATE_LIMIT_ENABLED=true
SENTRY_DSN=
BACKUP_RETENTION_DAYS=14
BACKUP_S3_URI=
